//
// Material 3 colour scheme.
//
// GENERATED BY MATUGEN - do not edit. Edit matugen/templates/quickshell-scheme.qml
// instead, then re-run `matugen image <wallpaper>`.
//
// Consumed by services/Colours.qml, which adds the layering/transparency helpers.
// Quickshell hot-reloads on file change, so a new wallpaper retints the bar live.
//
// The root type is services/M3Palette.qml rather than a bare QtObject: Colours
// keeps a second instance of the same component as a preview palette, which the
// wallpaper picker fills from a `matugen --dry-run`. The role names live there,
// so this file only assigns to them.
//
M3Palette {
    m3background: "#14140c"
    m3error: "#ffb4ab"
    m3errorContainer: "#93000a"
    m3inverseOnSurface: "#313128"
    m3inversePrimary: "#5f621a"
    m3inverseSurface: "#e5e3d6"
    m3onBackground: "#e5e3d6"
    m3onError: "#690005"
    m3onErrorContainer: "#ffdad6"
    m3onPrimary: "#313300"
    m3onPrimaryContainer: "#e5e891"
    m3onPrimaryFixed: "#1c1d00"
    m3onPrimaryFixedVariant: "#474a01"
    m3onSecondary: "#313219"
    m3onSecondaryContainer: "#e5e5c0"
    m3onSecondaryFixed: "#1c1d06"
    m3onSecondaryFixedVariant: "#47482d"
    m3onSurface: "#e5e3d6"
    m3onSurfaceVariant: "#c9c7b6"
    m3onTertiary: "#09372b"
    m3onTertiaryContainer: "#bfecda"
    m3onTertiaryFixed: "#002118"
    m3onTertiaryFixedVariant: "#244e41"
    m3outline: "#929182"
    m3outlineVariant: "#48473b"
    m3primary: "#c8cc78"
    m3primaryContainer: "#474a01"
    m3primaryFixed: "#e5e891"
    m3primaryFixedDim: "#c8cc78"
    m3scrim: "#000000"
    m3secondary: "#c9c9a5"
    m3secondaryContainer: "#47482d"
    m3secondaryFixed: "#e5e5c0"
    m3secondaryFixedDim: "#c9c9a5"
    m3shadow: "#000000"
    m3surface: "#14140c"
    m3surfaceBright: "#3a3a31"
    m3surfaceContainer: "#202018"
    m3surfaceContainerHigh: "#2b2a22"
    m3surfaceContainerHighest: "#35352c"
    m3surfaceContainerLow: "#1c1c14"
    m3surfaceContainerLowest: "#0e0f08"
    m3surfaceDim: "#14140c"
    m3surfaceTint: "#c8cc78"
    m3surfaceVariant: "#48473b"
    m3tertiary: "#a3d0bf"
    m3tertiaryContainer: "#244e41"
    m3tertiaryFixed: "#bfecda"
    m3tertiaryFixedDim: "#a3d0bf"

    // Recorded rather than inferred. Colours used to guess the mode back out of
    // the surface luminance, which is also true of the *preview* palette - and a
    // preview that looked light would have dragged the portal key and the GTK3
    // theme with it. Same expansion nvim-colors.vim uses for `set background=`.
    mode: "dark"
}
