//
// Material 3 colour scheme.
//
// GENERATED BY MATUGEN - do not edit. Edit matugen/templates/quickshell-scheme.qml
// instead, then re-run `matugen image <wallpaper>`.
//
// Consumed by services/Colours.qml, which adds the layering/transparency helpers.
// Quickshell hot-reloads on file change, so a new wallpaper retints the bar live.
//
// The root type is services/M3Palette.qml rather than a bare QtObject: Colours
// keeps a second instance of the same component as a preview palette, which the
// wallpaper picker fills from a `matugen --dry-run`. The role names live there,
// so this file only assigns to them.
//
M3Palette {
    m3background: "#111418"
    m3error: "#ffb4ab"
    m3errorContainer: "#93000a"
    m3inverseOnSurface: "#2e3135"
    m3inversePrimary: "#38608e"
    m3inverseSurface: "#e1e2e8"
    m3onBackground: "#e1e2e8"
    m3onError: "#690005"
    m3onErrorContainer: "#ffdad6"
    m3onPrimary: "#00325a"
    m3onPrimaryContainer: "#d2e4ff"
    m3onPrimaryFixed: "#001c37"
    m3onPrimaryFixedVariant: "#1c4975"
    m3onSecondary: "#253141"
    m3onSecondaryContainer: "#d7e3f8"
    m3onSecondaryFixed: "#101c2b"
    m3onSecondaryFixedVariant: "#3c4858"
    m3onSurface: "#e1e2e8"
    m3onSurfaceVariant: "#c3c6cf"
    m3onTertiary: "#3b2947"
    m3onTertiaryContainer: "#f4daff"
    m3onTertiaryFixed: "#251431"
    m3onTertiaryFixedVariant: "#533f5f"
    m3outline: "#8d9199"
    m3outlineVariant: "#43474e"
    m3primary: "#a2c9fd"
    m3primaryContainer: "#1c4975"
    m3primaryFixed: "#d2e4ff"
    m3primaryFixedDim: "#a2c9fd"
    m3scrim: "#000000"
    m3secondary: "#bbc7db"
    m3secondaryContainer: "#3c4858"
    m3secondaryFixed: "#d7e3f8"
    m3secondaryFixedDim: "#bbc7db"
    m3shadow: "#000000"
    m3surface: "#111418"
    m3surfaceBright: "#37393e"
    m3surfaceContainer: "#1d2024"
    m3surfaceContainerHigh: "#272a2f"
    m3surfaceContainerHighest: "#32353a"
    m3surfaceContainerLow: "#191c20"
    m3surfaceContainerLowest: "#0b0e13"
    m3surfaceDim: "#111418"
    m3surfaceTint: "#a2c9fd"
    m3surfaceVariant: "#43474e"
    m3tertiary: "#d7bde4"
    m3tertiaryContainer: "#533f5f"
    m3tertiaryFixed: "#f4daff"
    m3tertiaryFixedDim: "#d7bde4"

    // Recorded rather than inferred. Colours used to guess the mode back out of
    // the surface luminance, which is also true of the *preview* palette - and a
    // preview that looked light would have dragged the portal key and the GTK3
    // theme with it. Same expansion nvim-colors.vim uses for `set background=`.
    mode: "dark"
}
