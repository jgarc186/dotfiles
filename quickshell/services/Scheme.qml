//
// Material 3 colour scheme.
//
// GENERATED BY MATUGEN - do not edit. Edit matugen/templates/quickshell-scheme.qml
// instead, then re-run `matugen image <wallpaper>`.
//
// Consumed by services/Colours.qml, which adds the layering/transparency helpers.
// Quickshell hot-reloads on file change, so a new wallpaper retints the bar live.
//
// The root type is services/M3Palette.qml rather than a bare QtObject: Colours
// keeps a second instance of the same component as a preview palette, which the
// wallpaper picker fills from a `matugen --dry-run`. The role names live there,
// so this file only assigns to them.
//
M3Palette {
    m3background: "#191113"
    m3error: "#ffb4ab"
    m3errorContainer: "#93000a"
    m3inverseOnSurface: "#382e2f"
    m3inversePrimary: "#8d4959"
    m3inverseSurface: "#efdee0"
    m3onBackground: "#efdee0"
    m3onError: "#690005"
    m3onErrorContainer: "#ffdad6"
    m3onPrimary: "#551d2c"
    m3onPrimaryContainer: "#ffd9df"
    m3onPrimaryFixed: "#3a0717"
    m3onPrimaryFixedVariant: "#713342"
    m3onSecondary: "#43292e"
    m3onSecondaryContainer: "#ffd9df"
    m3onSecondaryFixed: "#2b151a"
    m3onSecondaryFixedVariant: "#5c3f44"
    m3onSurface: "#efdee0"
    m3onSurfaceVariant: "#d6c2c4"
    m3onTertiary: "#462a08"
    m3onTertiaryContainer: "#ffdcbc"
    m3onTertiaryFixed: "#2c1700"
    m3onTertiaryFixedVariant: "#5f401d"
    m3outline: "#9f8c8f"
    m3outlineVariant: "#524345"
    m3primary: "#ffb1c0"
    m3primaryContainer: "#713342"
    m3primaryFixed: "#ffd9df"
    m3primaryFixedDim: "#ffb1c0"
    m3scrim: "#000000"
    m3secondary: "#e4bdc3"
    m3secondaryContainer: "#5c3f44"
    m3secondaryFixed: "#ffd9df"
    m3secondaryFixedDim: "#e4bdc3"
    m3shadow: "#000000"
    m3surface: "#191113"
    m3surfaceBright: "#413738"
    m3surfaceContainer: "#261d1f"
    m3surfaceContainerHigh: "#312829"
    m3surfaceContainerHighest: "#3c3234"
    m3surfaceContainerLow: "#22191b"
    m3surfaceContainerLowest: "#140c0d"
    m3surfaceDim: "#191113"
    m3surfaceTint: "#ffb1c0"
    m3surfaceVariant: "#524345"
    m3tertiary: "#ecbe90"
    m3tertiaryContainer: "#5f401d"
    m3tertiaryFixed: "#ffdcbc"
    m3tertiaryFixedDim: "#ecbe90"

    // Recorded rather than inferred. Colours used to guess the mode back out of
    // the surface luminance, which is also true of the *preview* palette - and a
    // preview that looked light would have dragged the portal key and the GTK3
    // theme with it. Same expansion nvim-colors.vim uses for `set background=`.
    mode: "dark"
}
