#!/usr/bin/env bash
#
# Switch the desktop between light and dark.
#
# There is no single light/dark switch on Linux, so this drives the three
# layers that between them cover everything on this machine:
#
#   1. matugen  - regenerates every colour file in the dotfiles (hyprland,
#                 waybar, rofi, kitty, ghostty, nvim, quickshell). Each app
#                 reloads itself through the post_hooks in matugen/config.toml.
#   2. color-scheme  - the gsettings key xdg-desktop-portal-gtk publishes as
#                 org.freedesktop.appearance. Firefox, Chromium, Electron and
#                 GTK4/libadwaita apps read it and switch live.
#   3. gtk-theme - GTK3 apps, which predate the portal and need a named theme.
#
# Usage: theme-mode [light|dark|toggle|status]      (default: toggle)
#        theme-mode wallpaper <image> [index]
#                                       re-theme from a new wallpaper, staying
#                                       in the mode the desktop is already in
#        theme-mode apply <light|dark>  layers 2 and 3 only, no matugen run
#        theme-mode index               print the stored source-colour index
#
# Use `theme-mode wallpaper` rather than `matugen image` directly: matugen's
# --mode defaults to dark, so a bare run drags the palette to dark and leaves
# the other two layers where they were.
#
# Set MATUGEN_SOURCE_INDEX to pick a different candidate source colour out of
# the wallpaper - see --source-color-index in `matugen image --help`.
#
set -euo pipefail

IFACE="org.gnome.desktop.interface"
COLORS="${HOME}/.config/hypr/colors.conf"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/theme-mode"
INDEX_FILE="$STATE_DIR/source-index"

# When an image yields several candidate source colours, matugen asks which to
# use - and aborts outright ("IO error: not a terminal") rather than guessing if
# it can't find a terminal to ask in, which is every invocation that isn't a
# human at a shell. Answering the question up front is what makes this runnable
# from the bar or a keybind at all.
#
# The answer also has to be *remembered*. A light/dark toggle re-themes from the
# same wallpaper, so an index that only lived in the environment of the run that
# chose it would be silently discarded by the next toggle - the palette would
# jump back to index 0 with nothing on screen explaining why. So it is stored,
# and MATUGEN_SOURCE_INDEX overrides the stored value for a one-off run.
#
# 0 is the candidate that reproduces the palette this setup already had. Compare
# the others with:
#   matugen image <wall> -m dark --source-color-index <n> --dry-run -j hex
#
# How many candidates an image has varies: the flag itself caps at 0-3, but the
# real bound comes from the image, and matugen only reports it by failing
# ("Source color index 1 is out of bounds (0-0)").
stored_index() {
    local index
    index="$(cat "$INDEX_FILE" 2>/dev/null)" || index=""
    [[ $index =~ ^[0-9]+$ ]] && echo "$index" || echo 0
}

store_index() {
    mkdir -p "$STATE_DIR"
    echo "$1" >"$INDEX_FILE"
}

SOURCE_INDEX="${MATUGEN_SOURCE_INDEX:-$(stored_index)}"

die() {
    echo "theme-mode: $*" >&2
    exit 1
}

# The portal key is authoritative for what the system is set to. It starts life
# as 'default', which on this setup means the dark scheme matugen shipped with.
current_mode() {
    case "$(gsettings get "$IFACE" color-scheme 2>/dev/null)" in
    *prefer-light*) echo light ;;
    *) echo dark ;;
    esac
}

# matugen needs the image it themed from. The hyprland template writes it out
# as line 1 of colors.conf, so the current wallpaper is recoverable without
# hardcoding a path here.
current_wallpaper() {
    [[ -r $COLORS ]] || die "$COLORS not readable - has matugen ever run?"

    local image
    image="$(sed -n 's/^\$image = //p' "$COLORS" | head -1)"

    [[ -n $image ]] || die "no \$image line in $COLORS"
    [[ -f $image ]] || die "wallpaper $image no longer exists"

    echo "$image"
}

# Swap the light/dark variant of whatever GTK3 theme is set rather than
# hardcoding one, so changing themes doesn't mean editing this script. Left
# alone if the matching variant isn't installed.
#
# There is no one naming convention: Adwaita and most third-party themes suffix
# both variants (Materia-Light / Materia-Dark), while adw-gtk3 - the one this
# machine uses - names the light variant with no suffix at all (adw-gtk3 /
# adw-gtk3-dark). Casing varies too. So each mode gets a list of candidates,
# most explicit first, and the first one installed wins.
installed_theme() {
    local name
    for name; do
        if [[ -d /usr/share/themes/$name || -d $HOME/.themes/$name ]]; then
            echo "$name"
            return 0
        fi
    done
    return 1
}

gtk_theme_for() {
    local mode=$1 current base
    current="$(gsettings get "$IFACE" gtk-theme | tr -d \')"
    # Case-insensitively, since the suffix is capitalised on some themes and
    # not on others
    base="$(shopt -s nocasematch; [[ $current =~ ^(.*)-(light|dark)$ ]] && echo "${BASH_REMATCH[1]}" || echo "$current")"

    if [[ $mode == light ]]; then
        installed_theme "${base}-Light" "${base}-light" "$base" || echo "$current"
    else
        installed_theme "${base}-Dark" "${base}-dark" || echo "$current"
    fi
}

retheme() {
    matugen image "$1" --mode "$2" --source-color-index "$SOURCE_INDEX"
}

# Layers 2 and 3. Split out because the palette can move on its own - a matugen
# run from a terminal - and these two then need bringing to it without paying
# for a second re-theme.
apply_mode() {
    gsettings set "$IFACE" color-scheme "prefer-$1"
    gsettings set "$IFACE" gtk-theme "$(gtk_theme_for "$1")"
}

mode="${1:-toggle}"

case "$mode" in
status)
    current_mode
    exit 0
    ;;
index)
    echo "$SOURCE_INDEX"
    exit 0
    ;;
apply)
    target="${2:-}"
    [[ $target == light || $target == dark ]] || die "apply needs 'light' or 'dark'"
    apply_mode "$target"
    echo "$target"
    exit 0
    ;;
wallpaper)
    image="${2:-}"
    [[ -n $image ]] || die "wallpaper needs an image path"
    [[ -f $image ]] || die "no such image: $image"
    # Absolute, because matugen writes this path straight into colors.conf and
    # current_wallpaper reads it back from wherever the next run happens to be
    image="$(realpath "$image")"
    # An index given here becomes the stored one, so the next light/dark toggle
    # re-themes at it rather than dropping back to 0
    if [[ -n ${3:-} ]]; then
        [[ $3 =~ ^[0-9]+$ ]] || die "wallpaper index must be a number, got '$3'"
        SOURCE_INDEX="$3"
        store_index "$SOURCE_INDEX"
    fi
    keep="$(current_mode)"
    retheme "$image" "$keep"
    echo "$keep"
    exit 0
    ;;
toggle)
    [[ "$(current_mode)" == dark ]] && mode=light || mode=dark
    ;;
light | dark) ;;
*)
    die "unknown mode '$mode' (expected light, dark, toggle, status, index, wallpaper or apply)"
    ;;
esac

retheme "$(current_wallpaper)" "$mode"
apply_mode "$mode"

echo "$mode"
